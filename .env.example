# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hub_workspace

# JWT
JWT_ACCESS_SECRET=change-me-to-a-secure-random-string-32-chars-min
JWT_REFRESH_SECRET=change-me-to-a-different-secure-random-string-32-chars-min
# Access token: 15 minutes, Refresh token: 7 days (in seconds)
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Claude API (server-side only — never expose to client)
ANTHROPIC_API_KEY=sk-ant-...

# CORS
CORS_ORIGIN=http://localhost:5173
